# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# --- DÉPENDANCES ET ENVIRONNEMENTS ---
# Node.js (Frontend)
node_modules/
.pnp
.pnp.*
.yarn/

# Python (Backend)
.venv/
venv/
env/
ENV/
*.db
*.sqlite3
__pycache__/
*.py[cod]
*$py.class
.python-version
# Spécifique à 'uv' (ton prérequis)
.uv/

# --- FRAMEWORKS ET BUILDS ---
# Next.js
.next/
out/
.vercel/

# Builds divers
build/
dist/
*.tsbuildinfo

# --- CONFIGURATION ET SÉCURITÉ ---
# Fichiers d'environnement (NE JAMAIS PUSHER)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env*.local

# Clés et certificats
*.pem
*.key
*.cert

# --- SYSTÈME ET LOGS ---
# MacOS
.DS_Store
.AppleDouble
.LSOverride

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# --- OUTILS DE DÉVELOPPEMENT ---
# VS Code
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# Docker (si tu as des dossiers de données locaux)
.docker/